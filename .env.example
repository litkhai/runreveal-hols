# Copy to .env (gitignored), fill in, then: chmod 600 .env
# Read by scripts/connect_sources.py. A source is skipped while its required values are empty.

# RunReveal API. RUNREVEAL_WORKSPACE is the workspace ID, not its name.
# RUNREVEAL_BASEURL: https://api.runreveal.com for RunReveal Cloud; a console on another host
# has its own API host (the browser's network tab shows it on any console page).
RUNREVEAL_BASEURL=https://api.runreveal.com
RUNREVEAL_TOKEN=
RUNREVEAL_WORKSPACE=

# ClickHouse Cloud audit logs: an API key with only "View organization activities"
# (control-plane:organization:view-activities). Required: all three.
CHC_AUDIT_ORG_ID=
CHC_AUDIT_KEY_ID=
CHC_AUDIT_KEY_SECRET=

# GitHub audit log (API polling): an organization and a classic PAT with only read:audit_log.
# GITHUB_AUDIT_INCLUDE: "all", or empty for the console default (web events only).
GITHUB_AUDIT_ORG=
GITHUB_AUDIT_TOKEN=
GITHUB_AUDIT_INCLUDE=

# AWS CloudTrail (S3). Deploy RunReveal's CloudFormation template first (it creates the bucket,
# the SNS topic and the notifications), then put the bucket name here. Leave the role ARN empty
# to use RunReveal's own role, as the template expects.
CLOUDTRAIL_BUCKET=
CLOUDTRAIL_PATH_PREFIX=
CLOUDTRAIL_ROLE_ARN=
CLOUDTRAIL_EXTERNAL_ID=

# Optional: source names (default: the source type).
# CLICKHOUSE_CLOUD_AUDIT_NAME=
# GITHUB_NAME=
# CLOUDTRAIL_NAME=
